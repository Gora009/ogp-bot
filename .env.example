DISCORD_TOKEN=
POLL_SECONDS=30
FORUM_URL=https://forum.gta5rp.com/forums/zhaloby-v-prokuraturu.2142/
# через сколько секунд бот сам назначает жалобу (0 = сразу, -1 = не назначать)
AUTO_ASSIGN_SECONDS=0

# --- прочее (доступ и роли прокуроров/судей настраиваются в Discord командой /access) ---
# роль «Отпуск»: выдаётся автоматически в день начала отпуска (боту нужно право Manage Roles, его роль выше этой)
VACATION_ROLE_ID=
# ID сервера Прокуратуры (для /check_members и /invite_missing)
PROSECUTION_GUILD_ID=

# ID пользователей Discord (через запятую) с полным доступом ко всему (владелец сервера и владелец приложения имеют его и так)
ADMIN_USER_IDS=

# Разбор документов (/analyze и «Подробно»): ключ ИИ — Claude, DeepSeek, OpenAI, Gemini, Groq, OpenRouter или xAI (сервис определяется по ключу).
# Без ключа работает упрощённый разбор без ИИ.
AI_API_KEY=
# необязательно: модель и адрес API вручную
AI_BASE_URL=
AI_MODEL=
